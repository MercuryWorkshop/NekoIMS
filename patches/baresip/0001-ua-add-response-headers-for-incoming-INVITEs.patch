+/**
+ * Set SIP headers for the responses to incoming INVITEs (180, 183, 2xx),
+ * e.g. P-Access-Network-Info (3GPP TS 24.229 5.1.4.2)
+ *
+ * @param ua   User-Agent object
+ * @param hdrs Headers, each ending in CRLF, or NULL to clear
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int ua_set_resp_headers(struct ua *ua, const char *hdrs)
+{
+	if (!ua)
+		return EINVAL;
+
+	ua->resp_hdrs = mem_deref(ua->resp_hdrs);
+
+	return hdrs ? str_dup(&ua->resp_hdrs, hdrs) : 0;
+}
+
+
+/**
+ * Get the SIP headers for responses to incoming INVITEs
+ *
+ * @param ua User-Agent object
+ *
+ * @return Headers (empty string if none)
+ */
+const char *ua_resp_headers(const struct ua *ua)
+{
+	return ua && ua->resp_hdrs ? ua->resp_hdrs : "";
+}
