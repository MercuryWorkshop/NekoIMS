diff --git a/src/ua.c b/src/ua.c
--- a/src/ua.c
+++ b/src/ua.c
@@ -2000,6 +2000,22 @@ int ua_set_media_laddr(struct ua *ua, const struct sa *laddr)
 }
 
 
+/**
+ * Get the fixed local address for the media of this UA's calls
+ *
+ * @param ua User-Agent
+ *
+ * @return The address, NULL if media follows routing
+ */
+const struct sa *ua_media_laddr(const struct ua *ua)
+{
+	if (!ua || !sa_isset(&ua->media_laddr, SA_ADDR))
+		return NULL;
+
+	return &ua->media_laddr;
+}
