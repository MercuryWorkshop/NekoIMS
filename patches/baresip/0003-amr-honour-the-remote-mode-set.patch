 		return 0;
 
-	if (amr_ac->aligned) {
-		return mbuf_printf(mb, "a=fmtp:%s octet-align=1\r\n",
-			   fmt->id);
-	}
+	/* An answer repeats the offer's mode-set (RFC 4867 8.3.1) */
