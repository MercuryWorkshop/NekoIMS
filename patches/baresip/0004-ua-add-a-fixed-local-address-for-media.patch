+/**
+ * Use a fixed local address for the media of this UA's calls, instead of
+ * the one routed toward the peer. NULL goes back to routing.
+ *
+ * @param ua    User-Agent
+ * @param laddr Local address, or NULL
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int ua_set_media_laddr(struct ua *ua, const struct sa *laddr)
+{
+	if (!ua)
+		return EINVAL;
+
+	if (laddr)
+		sa_cpy(&ua->media_laddr, laddr);
+	else
+		sa_init(&ua->media_laddr, AF_UNSPEC);
+
+	return 0;
+}
